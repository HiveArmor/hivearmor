# HiveArmor staging Compose — do not use local-dev defaults.
# Required: copy to .env and set unique secrets. `localdev123!` / LocalDev@2024! are rejected.

SERVER_NAME=staging.example.internal
POSTGRES_PASSWORD=
OPENSEARCH_INITIAL_ADMIN_PASSWORD=
INTERNAL_KEY=
ENCRYPTION_KEY=
# Base64 of 64 random bytes (HS512). Generate: openssl rand -base64 64 | tr -d '\n'
HIVEARMOR_ENCRYPTION_KEY=
# Base64 of 32 random bytes (AES-256). Generate: openssl rand -base64 32 | tr -d '\n'
# Do not reuse ENCRYPTION_KEY for HIVEARMOR_ENCRYPTION_KEY.
# Optional: comma-separated agent binary dirs (default /dependencies/agent,/updates/agent)
# HIVEARMOR_AGENT_PACKAGE_DIRS=/dependencies/agent,/updates/agent
INPUTS_SOCKET_SECRET=
JHIPSTER_CORS_ALLOWED_ORIGINS=https://staging.example.internal
APP_TFA_ENABLED=false
