{
  "name": "hivearmor-frontend-v3",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test:storybook": "npm run storybook:build && playwright test --config playwright.storybook.config.ts",
    "test:storybook:update": "npm run storybook:build && playwright test --config playwright.storybook.config.ts --update-snapshots",
    "test:e2e": "playwright test",
    "test:e2e:intelligence": "playwright test e2e/hive-intelligence.spec.ts",
    "test:e2e:intelligence:headed": "playwright test e2e/hive-intelligence.spec.ts --headed"
  },
  "dependencies": {
    "@monaco-editor/react": "4.6.0",
    "@patternfly/react-core": "6.1.0",
    "@patternfly/react-icons": "6.1.0",
    "@tanstack/react-query": "5.51.21",
    "ag-grid-community": "36.0.0",
    "ag-grid-react": "36.0.0",
    "echarts": "5.5.1",
    "echarts-for-react": "3.0.2",
    "gridstack": "13.0.0",
    "lucide-react": "0.408.0",
    "monaco-editor": "0.50.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.25.1",
    "reactflow": "^11.11.4",
    "zustand": "5.0.0-rc.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@fast-check/vitest": "^0.4.1",
    "@playwright/test": "^1.62.0",
    "@storybook/addon-a11y": "^10.5.4",
    "@storybook/react": "^10.5.4",
    "@storybook/react-vite": "^10.5.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.4.6",
    "@testing-library/react": "16.0.0",
    "@testing-library/user-event": "14.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "7.15.0",
    "@typescript-eslint/parser": "7.15.0",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "^4.12.1",
    "esbuild": "^0.28.0",
    "eslint": "8.57.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-react": "7.34.3",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.7",
    "fast-check": "^3.22.0",
    "jsdom": "24.1.1",
    "msw": "^2.15.0",
    "storybook": "^10.5.4",
    "stylelint": "16.10.0",
    "typescript": "5.5.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
