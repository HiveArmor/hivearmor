<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <!-- Sprint 41 — Response action job tracking table (ALT-010) -->
    <changeSet id="20260811001" author="hivearmor">
        <createTable tableName="response_jobs">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="action_id" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="target_id" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="target_type" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="parameters" type="text"/>
            <column name="status" type="varchar(32)" defaultValue="queued">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="approved_by" type="varchar(255)"/>
            <column name="tenant_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="started_at" type="timestamp"/>
            <column name="completed_at" type="timestamp"/>
            <column name="result" type="text"/>
            <column name="error_code" type="varchar(64)"/>
            <column name="error_message" type="text"/>
            <column name="alert_id" type="varchar(64)"/>
        </createTable>

        <createIndex tableName="response_jobs" indexName="idx_response_jobs_status">
            <column name="status"/>
        </createIndex>

        <createIndex tableName="response_jobs" indexName="idx_response_jobs_alert">
            <column name="alert_id"/>
        </createIndex>

        <createIndex tableName="response_jobs" indexName="idx_response_jobs_tenant">
            <column name="tenant_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
