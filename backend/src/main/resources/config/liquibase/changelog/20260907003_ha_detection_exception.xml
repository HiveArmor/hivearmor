<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <!-- DET-FP-001: persisted detection rule exceptions / suppressions (STAGING CANDIDATE) -->
    <changeSet id="20260907003-1" author="hivearmor">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ha_detection_exception"/>
            </not>
        </preConditions>

        <createTable tableName="ha_detection_exception">
            <column name="id" type="bigserial" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="rule_id" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="varchar(500)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="text">
                <constraints nullable="true"/>
            </column>
            <column name="conditions_json" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(32)" defaultValue="draft">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(200)">
                <constraints nullable="true"/>
            </column>
            <column name="activated_by" type="varchar(200)">
                <constraints nullable="true"/>
            </column>
            <column name="activated_at" type="timestamp">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_ha_detection_exception_rule" tableName="ha_detection_exception">
            <column name="rule_id"/>
        </createIndex>
        <createIndex indexName="idx_ha_detection_exception_active" tableName="ha_detection_exception">
            <column name="active"/>
        </createIndex>
        <createIndex indexName="idx_ha_detection_exception_status" tableName="ha_detection_exception">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
