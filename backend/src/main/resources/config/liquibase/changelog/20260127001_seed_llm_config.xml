<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <!-- Sprint 27 — Seed LLM configuration section -->
    <changeSet id="20260127001-seed-llm-section" author="hivearmor">
        <preConditions onFail="MARK_RAN">
            <not>
                <sqlCheck expectedResult="1">
                    SELECT COUNT(*) FROM hive_configuration_section WHERE id = 11
                </sqlCheck>
            </not>
        </preConditions>
        <insert tableName="hive_configuration_section">
            <column name="id" valueNumeric="11"/>
            <column name="section" value="LLM Configuration"/>
            <column name="description" value="Settings for the pluggable LLM provider (Ollama, OpenAI, Azure OpenAI). Controls which provider is active and its connection parameters."/>
            <column name="short_name" value="LLM_CONFIG"/>
            <column name="section_active" valueBoolean="true"/>
        </insert>
    </changeSet>

    <!-- LLM_PROVIDER -->
    <changeSet id="20260127001-seed-llm-provider" author="hivearmor">
        <preConditions onFail="MARK_RAN">
            <not>
                <sqlCheck expectedResult="1">
                    SELECT COUNT(*) FROM hive_configuration_parameter WHERE conf_param_short = 'LLM_PROVIDER'
                </sqlCheck>
            </not>
        </preConditions>
        <insert tableName="hive_configuration_parameter">
            <column name="id" valueNumeric="42"/>
            <column name="section_id" valueNumeric="11"/>
            <column name="conf_param_short" value="LLM_PROVIDER"/>
            <column name="conf_param_large" value="LLM Provider"/>
            <column name="conf_param_description" value="Active LLM provider. One of: disabled, openai, azure, ollama."/>
            <column name="conf_param_value" value="disabled"/>
            <column name="conf_param_required" valueBoolean="true"/>
            <column name="conf_param_datatype" value="text"/>
            <column name="modification_time" value="NULL"/>
            <column name="modification_user" value="NULL"/>
            <column name="conf_param_option" value="disabled,openai,azure,ollama"/>
            <column name="conf_param_regexp" value="NULL"/>
        </insert>
    </changeSet>

