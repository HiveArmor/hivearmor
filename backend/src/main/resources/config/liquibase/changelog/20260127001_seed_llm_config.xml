            <column name="id" valueNumeric="43"/>
            <column name="section_id" valueNumeric="11"/>
            <column name="conf_param_short" value="LLM_BASE_URL"/>
            <column name="conf_param_large" value="LLM Base URL"/>
            <column name="conf_param_description" value="Base URL for the active LLM provider (e.g. http://ollama:11434 for Ollama, or the Azure endpoint URL)."/>
            <column name="conf_param_value" value=""/>
            <column name="conf_param_required" valueBoolean="false"/>
            <column name="conf_param_datatype" value="text"/>
            <column name="modification_time" value="NULL"/>
            <column name="modification_user" value="NULL"/>
            <column name="conf_param_option" value="NULL"/>
            <column name="conf_param_regexp" value="NULL"/>
        </insert>
    </changeSet>

