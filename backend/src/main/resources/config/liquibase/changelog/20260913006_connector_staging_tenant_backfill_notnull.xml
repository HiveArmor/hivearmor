<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <!--
      SPEC-04 (W1b) PR-1b.2c-i backfill + NOT-NULL for
      ha_connector_alert_staging.tenant_id (added by 20260913005).

      Same contract as 20260910003 / 20260913002 / 20260913004:
        * SINGLE-TENANT (no MSSP-managed client with a prefix): every legacy row's
          tenant is 0 — backfill to 0 is correct and COMPLETE, NOT-NULL enforced.
          Gated by the ha_client sqlCheck.
        * MSSP: MARK_RAN (no-op). Going forward, new staging rows inherit tenant_id
          from their parent ha_connector_instance at insert. Legacy MSSP staging rows
          could be derived from the parent instance's tenant_id, but that is left to
          the same application-level backfill contract; NOT-NULL for MSSP deferred.
    -->
    <changeSet id="20260913006-1" author="hivearmor">
        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="ha_connector_alert_staging" columnName="tenant_id"/>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM ha_client WHERE mssp_managed = TRUE AND client_prefix IS NOT NULL
                </sqlCheck>
            </and>
        </preConditions>
        <update tableName="ha_connector_alert_staging">
            <column name="tenant_id" valueNumeric="0"/>
            <where>tenant_id IS NULL</where>
        </update>
        <addNotNullConstraint tableName="ha_connector_alert_staging" columnName="tenant_id"
                              columnDataType="BIGINT" defaultNullValue="0"/>
    </changeSet>

</databaseChangeLog>
