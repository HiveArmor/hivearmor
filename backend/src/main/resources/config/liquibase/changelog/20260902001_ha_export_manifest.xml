<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <!-- B0-4 Forensic export chain-of-custody manifest -->
    <changeSet id="20260902001-1" author="hivearmor">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ha_export_manifest"/>
            </not>
        </preConditions>

        <createTable tableName="ha_export_manifest">
            <column name="id" type="bigserial" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="export_id" type="varchar(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="exported_by" type="varchar(200)">
                <constraints nullable="true"/>
            </column>
            <column name="exported_at" type="timestamp" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="tenant" type="varchar(200)" defaultValue="default">
                <constraints nullable="true"/>
            </column>
            <column name="surface" type="varchar(64)">
                <constraints nullable="true"/>
            </column>
            <column name="format" type="varchar(16)">
                <constraints nullable="true"/>
            </column>
            <column name="index_pattern" type="varchar(500)">
                <constraints nullable="true"/>
            </column>
            <column name="record_count" type="bigint" defaultValueNumeric="0">
                <constraints nullable="true"/>
            </column>
            <column name="sha256" type="varchar(64)">
                <constraints nullable="true"/>
            </column>
            <column name="query_json" type="text">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <createIndex indexName="idx_ha_export_manifest_export_id" tableName="ha_export_manifest" unique="true">
            <column name="export_id"/>
        </createIndex>

        <createIndex indexName="idx_ha_export_manifest_tenant" tableName="ha_export_manifest">
            <column name="tenant"/>
        </createIndex>

        <createIndex indexName="idx_ha_export_manifest_exported_at" tableName="ha_export_manifest">
            <column name="exported_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
