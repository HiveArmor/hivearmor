<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="20260725001-sigma-rule" author="hivearmor">
        <createTable tableName="ha_sigma_rule">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="sigma_id" type="VARCHAR(50)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="rule_title" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="rule_status" type="VARCHAR(50)"/>
            <column name="logsource_product" type="VARCHAR(100)"/>
            <column name="logsource_service" type="VARCHAR(100)"/>
            <column name="detection_yaml" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="ha_severity" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="mitre_tags" type="VARCHAR(1000)"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="imported_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="ha_sigma_rule" indexName="idx_sigma_rule_product">
            <column name="logsource_product"/>
        </createIndex>
        <createIndex tableName="ha_sigma_rule" indexName="idx_sigma_rule_severity">
            <column name="ha_severity"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
