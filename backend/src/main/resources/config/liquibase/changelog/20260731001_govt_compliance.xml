<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <changeSet id="20260731001-1" author="hivearmor">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ha_poam_item"/>
            </not>
        </preConditions>

        <createTable tableName="ha_poam_item">
            <column name="id" type="bigserial" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="framework_id" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="control_id" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="varchar(500)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text">
                <constraints nullable="true"/>
            </column>
            <column name="status" type="varchar(30)" defaultValue="open">
                <constraints nullable="false"/>
            </column>
            <column name="assignee" type="varchar(200)">
                <constraints nullable="true"/>
            </column>
            <column name="due_date" type="date">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_ha_poam_framework" tableName="ha_poam_item">
            <column name="framework_id"/>
        </createIndex>

        <createIndex indexName="idx_ha_poam_status" tableName="ha_poam_item">
            <column name="status"/>
        </createIndex>

        <createIndex indexName="idx_ha_poam_due_date" tableName="ha_poam_item">
            <column name="due_date"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
