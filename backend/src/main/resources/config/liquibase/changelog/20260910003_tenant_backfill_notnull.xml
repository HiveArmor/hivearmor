            <where>tenant_id IS NULL</where>
        </update>
        <addNotNullConstraint tableName="hive_edr_quarantine" columnName="tenant_id"
                              columnDataType="BIGINT" defaultNullValue="0"/>
    </changeSet>

    <!-- ha_edr_quarantine -->
    <changeSet id="20260910003-3" author="hivearmor">
        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="ha_edr_quarantine" columnName="tenant_id"/>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM ha_client WHERE mssp_managed = TRUE AND client_prefix IS NOT NULL
                </sqlCheck>
            </and>
        </preConditions>
        <update tableName="ha_edr_quarantine">
            <column name="tenant_id" valueNumeric="0"/>
            <where>tenant_id IS NULL</where>
        </update>
        <addNotNullConstraint tableName="ha_edr_quarantine" columnName="tenant_id"
                              columnDataType="BIGINT" defaultNullValue="0"/>
    </changeSet>

    <!-- hive_alert_response_rule_execution -->
    <changeSet id="20260910003-4" author="hivearmor">
        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="hive_alert_response_rule_execution" columnName="tenant_id"/>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM ha_client WHERE mssp_managed = TRUE AND client_prefix IS NOT NULL
                </sqlCheck>
            </and>
        </preConditions>
        <update tableName="hive_alert_response_rule_execution">
            <column name="tenant_id" valueNumeric="0"/>
            <where>tenant_id IS NULL</where>
        </update>
        <addNotNullConstraint tableName="hive_alert_response_rule_execution" columnName="tenant_id"
                              columnDataType="BIGINT" defaultNullValue="0"/>
    </changeSet>

</databaseChangeLog>
